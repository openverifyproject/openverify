{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verification:draft:run-record",
  "description": "Snapshots retaining identity, admission, lineage, outputs, usage and UTC timing.",
  "type": "object",
  "properties": {
    "protocol": {
      "const": "draft"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "$ref": "urn:verification:draft:verification-definition"
    },
    "definition_fingerprint": {
      "type": "string",
      "minLength": 1,
      "pattern": "^local-sha256:[0-9a-f]{64}$"
    },
    "subject": {
      "$ref": "urn:verification:draft:artifact-ref"
    },
    "initial_context": {
      "type": "object"
    },
    "run_inputs": {
      "type": "object"
    },
    "opportunity_id": {
      "type": "string",
      "minLength": 1
    },
    "admission": {
      "$ref": "urn:verification:draft:admission"
    },
    "policy_evaluations": {
      "type": "array",
      "items": {
        "$ref": "urn:verification:draft:policy-evaluation"
      }
    },
    "cancellation": {
      "$ref": "urn:verification:draft:cancellation-event"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:[Zz]|\\+00:00)$"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:[Zz]|\\+00:00)$"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "DERIVE",
              "EVALUATE",
              "CONTROL",
              "AGGREGATE"
            ]
          },
          "operation": {
            "$ref": "urn:verification:draft:operation-requirement"
          },
          "executor_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "executor_version": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "upstream_node_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "upstream_results": {
            "type": "object",
            "additionalProperties": {
              "$ref": "urn:verification:draft:result"
            }
          },
          "input_values": {
            "type": "object"
          },
          "input_resolutions": {
            "type": "object",
            "additionalProperties": {
              "$ref": "urn:verification:draft:input-resolution"
            }
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "(?:[Zz]|\\+00:00)$"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "(?:[Zz]|\\+00:00)$"
          },
          "usage": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "$ref": "urn:verification:draft:resource"
            }
          },
          "state": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "ERROR",
              "NONEXECUTED",
              "CANCELLED"
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "observation": {
            "$ref": "urn:verification:draft:execution-observation"
          },
          "information": {
            "type": "object"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "urn:verification:draft:result"
              },
              {
                "type": "null"
              }
            ]
          },
          "decision": {
            "anyOf": [
              {
                "$ref": "urn:verification:draft:decision"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "node_id",
          "kind",
          "operation",
          "upstream_node_ids",
          "upstream_results",
          "input_values",
          "input_resolutions",
          "started_at",
          "finished_at",
          "usage",
          "state",
          "information"
        ],
        "additionalProperties": false
      }
    },
    "final_results": {
      "type": "object",
      "additionalProperties": {
        "$ref": "urn:verification:draft:result"
      }
    },
    "metadata": {
      "type": "object"
    },
    "extensions": {
      "type": "array",
      "items": {
        "$ref": "urn:verification:draft:extension"
      }
    }
  },
  "required": [
    "protocol",
    "run_id",
    "definition",
    "definition_fingerprint",
    "subject",
    "initial_context",
    "run_inputs",
    "opportunity_id",
    "admission",
    "policy_evaluations",
    "started_at",
    "finished_at",
    "nodes",
    "final_results"
  ],
  "additionalProperties": false
}
