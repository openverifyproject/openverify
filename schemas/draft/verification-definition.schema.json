{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verification:draft:verification-definition",
  "description": "Versioned subject/criterion, judgment schema, graph and policy.",
  "type": "object",
  "properties": {
    "protocol": {
      "const": "draft"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "$ref": "urn:verification:draft:artifact-ref"
    },
    "criterion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object"
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "urn:verification:draft:extension"
          }
        }
      },
      "required": [
        "id",
        "description"
      ],
      "additionalProperties": false
    },
    "judgment_schema": {
      "type": [
        "object",
        "boolean"
      ]
    },
    "run_inputs": {
      "type": "array",
      "items": {
        "$ref": "urn:verification:draft:input-port"
      }
    },
    "satisfaction_mapping": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "graph": {
      "$ref": "urn:verification:draft:graph"
    },
    "execution_policy": {
      "type": "object",
      "properties": {
        "activation": {
          "type": "object",
          "properties": {
            "operation": {
              "$ref": "urn:verification:draft:operation-requirement"
            },
            "config": {
              "type": "object"
            },
            "config_schema": {
              "type": [
                "object",
                "boolean"
              ]
            },
            "inputs": {
              "type": "array",
              "items": {
                "$ref": "urn:verification:draft:input-port"
              }
            },
            "bindings": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "$ref": "urn:verification:draft:value-source"
              }
            },
            "executor_ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "selection": {
          "type": "object",
          "properties": {
            "operation": {
              "$ref": "urn:verification:draft:operation-requirement"
            },
            "config": {
              "type": "object"
            },
            "config_schema": {
              "type": [
                "object",
                "boolean"
              ]
            },
            "inputs": {
              "type": "array",
              "items": {
                "$ref": "urn:verification:draft:input-port"
              }
            },
            "bindings": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "$ref": "urn:verification:draft:value-source"
              }
            },
            "executor_ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "admission": {
          "type": "object",
          "properties": {
            "operation": {
              "$ref": "urn:verification:draft:operation-requirement"
            },
            "config": {
              "type": "object"
            },
            "config_schema": {
              "type": [
                "object",
                "boolean"
              ]
            },
            "inputs": {
              "type": "array",
              "items": {
                "$ref": "urn:verification:draft:input-port"
              }
            },
            "bindings": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "$ref": "urn:verification:draft:value-source"
              }
            },
            "strategy": {
              "type": "string",
              "minLength": 1
            },
            "probability": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "activation",
        "selection",
        "admission"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object"
    },
    "extensions": {
      "type": "array",
      "items": {
        "$ref": "urn:verification:draft:extension"
      }
    }
  },
  "required": [
    "protocol",
    "id",
    "version",
    "subject",
    "criterion",
    "judgment_schema",
    "run_inputs",
    "graph",
    "execution_policy"
  ],
  "additionalProperties": false
}
