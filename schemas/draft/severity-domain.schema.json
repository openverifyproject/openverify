{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verification:draft:severity-domain",
  "description": "Ordered severity labels; prose requires unique labels and distinct ranks.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "rank": {
            "type": "integer"
          }
        },
        "required": [
          "label",
          "rank"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "levels"
  ],
  "additionalProperties": false
}
