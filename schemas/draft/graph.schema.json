{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verification:draft:graph",
  "description": "Directed graph subset with source equality guards; semantic validation rejects unsupported standard weighted graph aggregation.",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "DERIVE",
              "EVALUATE",
              "CONTROL",
              "AGGREGATE"
            ]
          },
          "executor_ref": {
            "type": "string",
            "minLength": 1
          },
          "config": {
            "type": "object"
          },
          "resource_estimate": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "$ref": "urn:verification:draft:resource"
            }
          },
          "metadata": {
            "type": "object"
          },
          "extensions": {
            "type": "array",
            "items": {
              "$ref": "urn:verification:draft:extension"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "executor_ref"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from_node": {
            "type": "string",
            "minLength": 1
          },
          "to_node": {
            "type": "string",
            "minLength": 1
          },
          "guard": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "node_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "field": {
                    "type": "string",
                    "enum": [
                      "disposition",
                      "execution_outcome",
                      "applicability",
                      "determination",
                      "verdict",
                      "decision_kind",
                      "decision_destination"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "node_id",
                  "field",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "from_node",
          "to_node"
        ],
        "additionalProperties": false
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "CYCLES",
          "DYNAMIC_EXPANSION"
        ]
      }
    }
  },
  "required": [
    "nodes"
  ],
  "additionalProperties": false
}
