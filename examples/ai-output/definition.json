{
  "protocol": "draft",
  "id": "answer-review",
  "version": "1",
  "subject": {
    "id": "answer-1",
    "type": "text/plain",
    "locator": {
      "host_key": "answer"
    }
  },
  "criterion": {
    "id": "answer-acceptability",
    "description": "The answer has the requested form and receives review."
  },
  "judgment_schema": {},
  "execution_policy": {
    "activation": {
      "executor_ref": "MANUAL"
    },
    "selection": {
      "executor_ref": "EXPLICIT"
    },
    "admission": {
      "strategy": "ALWAYS"
    }
  },
  "graph": {
    "nodes": [
      {
        "id": "form",
        "kind": "EVALUATE",
        "executor_ref": "demo.regex",
        "config": {
          "key": "answer",
          "pattern": "^Answer:",
          "must_match": true
        }
      },
      {
        "id": "mock-judge",
        "kind": "EVALUATE",
        "executor_ref": "demo.constant",
        "config": {
          "result": {
            "protocol": "draft",
            "disposition": "EXECUTED",
            "execution_outcome": "SUCCESS",
            "applicability": "APPLICABLE",
            "determination": "UNKNOWN"
          }
        }
      },
      {
        "id": "escalate",
        "kind": "CONTROL",
        "executor_ref": "demo.unknown-route",
        "config": {
          "destination": "human-review"
        }
      },
      {
        "id": "human-review",
        "kind": "EVALUATE",
        "executor_ref": "demo.constant",
        "config": {
          "result": {
            "protocol": "draft",
            "disposition": "EXECUTED",
            "execution_outcome": "SUCCESS",
            "applicability": "APPLICABLE",
            "determination": "KNOWN",
            "verdict": "PASS",
            "evidence": [
              {
                "message": "Mock reviewer accepted the response."
              }
            ]
          }
        }
      }
    ],
    "edges": [
      {
        "from_node": "form",
        "to_node": "escalate"
      },
      {
        "from_node": "mock-judge",
        "to_node": "escalate"
      },
      {
        "from_node": "escalate",
        "to_node": "human-review",
        "guard": {
          "node_id": "escalate",
          "field": "decision_destination",
          "value": "human-review"
        }
      }
    ]
  }
}
