{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verification:draft:value-source",
  "description": "Typed explicit executable dataflow; see spec/draft/dataflow.md.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "CONSTANT"
        },
        "value": {}
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "RUN_INPUT"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "EXTERNAL_REFERENCE"
        },
        "reference": {
          "$ref": "urn:verification:draft:artifact-ref"
        }
      },
      "required": [
        "kind",
        "reference"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "UPSTREAM_OUTPUT"
        },
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "node_id",
        "output"
      ],
      "additionalProperties": false
    }
  ]
}
