{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verification:draft:profile",
  "description": "Named common choices organized by concept; this is not the core ontology.",
  "type": "object",
  "properties": {
    "protocol": {
      "const": "draft"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "flattened_statuses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "severity_domain": {
      "$ref": "urn:verification:draft:severity-domain"
    },
    "aggregators": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "admission_policies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resource_dimensions": {
      "type": "array",
      "items": {
        "$ref": "urn:verification:draft:resource-dimension"
      }
    },
    "metadata": {
      "type": "object"
    },
    "extensions": {
      "type": "array",
      "items": {
        "$ref": "urn:verification:draft:extension"
      }
    }
  },
  "required": [
    "protocol",
    "id",
    "version",
    "flattened_statuses",
    "severity_domain",
    "aggregators",
    "admission_policies",
    "decisions",
    "resource_dimensions"
  ],
  "additionalProperties": false
}
