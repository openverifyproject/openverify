{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verification:draft:admission",
  "description": "Typed explicit executable dataflow; see spec/draft/dataflow.md.",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "RUN",
        "SKIP",
        "DEFER"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "outcome",
    "reason"
  ],
  "additionalProperties": false
}
