{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verification:draft:graph",
  "description": "Typed DAG with explicit input bindings, operation requirements and aggregate membership.",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "DERIVE",
              "EVALUATE",
              "CONTROL",
              "AGGREGATE"
            ]
          },
          "operation": {
            "$ref": "urn:verification:draft:operation-requirement"
          },
          "inputs": {
            "type": "array",
            "items": {
              "$ref": "urn:verification:draft:input-port"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "$ref": "urn:verification:draft:output-port"
            }
          },
          "bindings": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "$ref": "urn:verification:draft:value-source"
            }
          },
          "aggregate_inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "config": {
            "type": "object"
          },
          "config_schema": {
            "type": [
              "object",
              "boolean"
            ]
          },
          "resource_estimate": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "$ref": "urn:verification:draft:resource"
            }
          },
          "metadata": {
            "type": "object"
          },
          "extensions": {
            "type": "array",
            "items": {
              "$ref": "urn:verification:draft:extension"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "operation",
          "inputs",
          "outputs",
          "bindings"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from_node": {
            "type": "string",
            "minLength": 1
          },
          "to_node": {
            "type": "string",
            "minLength": 1
          },
          "guard": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "source": {
                    "$ref": "urn:verification:draft:value-source"
                  },
                  "pointer": {
                    "type": "string"
                  },
                  "value": {}
                },
                "required": [
                  "source",
                  "pointer",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "from_node",
          "to_node"
        ],
        "additionalProperties": false
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "CYCLES",
          "DYNAMIC_EXPANSION"
        ]
      }
    }
  },
  "required": [
    "nodes"
  ],
  "additionalProperties": false
}
