{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openverify:provider:0.1:invocation",
  "type": "object",
  "properties": {
    "invocation_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "const": "0.1"
    },
    "capability_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:openverify\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*|(?!openverify\\.)[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*)$"
    },
    "capability_version": {
      "type": "string",
      "minLength": 1
    },
    "input": {},
    "config": {},
    "context": {},
    "vcp_version": {
      "type": "string",
      "minLength": 1
    },
    "deadline": {
      "type": "string",
      "minLength": 1,
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|\\+00:00)$"
    },
    "resource_budget": {
      "type": "object",
      "additionalProperties": {
        "$ref": "urn:verification:draft:resource"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?:openverify\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*|(?!openverify\\.)[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*)$"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "invocation_id",
    "contract_version",
    "capability_id",
    "capability_version",
    "input",
    "config"
  ],
  "additionalProperties": false
}
