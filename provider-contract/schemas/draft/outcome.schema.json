{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openverify:provider:0.1:outcome",
  "type": "object",
  "properties": {
    "invocation_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "COMPLETED",
        "ERROR",
        "CANCELLED",
        "DEADLINE_EXCEEDED"
      ]
    },
    "output": {},
    "error": {
      "$ref": "urn:openverify:provider:0.1:provider-error"
    },
    "resource_usage": {
      "type": "object",
      "additionalProperties": {
        "$ref": "urn:verification:draft:resource"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?:openverify\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*|(?!openverify\\.)[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*)$"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "invocation_id",
    "state"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "COMPLETED"
          }
        }
      },
      "then": {
        "required": [
          "output"
        ],
        "not": {
          "required": [
            "error"
          ]
        }
      },
      "else": {
        "not": {
          "required": [
            "output"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "ERROR"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      },
      "else": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    }
  ]
}
